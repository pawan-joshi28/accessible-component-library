{
  "name": "accessible-component-library",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-dependency, WCAG 2.1 AA React component library with Storybook and a Webpack Module Federation demo.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build -o dist/storybook",
    "build:lib": "tsc -p tsconfig.lib.json",
    "dev:federation": "webpack serve --config webpack.config.cjs --config-name remote & webpack serve --config webpack.config.cjs --config-name host",
    "build:federation": "NODE_ENV=production webpack --config webpack.config.cjs",
    "build:pages": "npm run build:storybook && NODE_ENV=production webpack --config webpack.config.cjs && node scripts/pages.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-webpack5": "^8.6.18",
    "@swc/core": "^1.16.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "jest-axe": "^11.0.0",
    "jsdom": "^24.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^8.6.18",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "types": "dist/lib/index.d.ts",
  "files": [
    "dist/lib",
    "src/styles.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "module": "dist/lib/index.js",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "*.css"
  ]
}
